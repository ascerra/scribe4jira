{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scribe-result.schema.json",
  "title": "Scribe Agent Result (Jira)",
  "description": "Structured output from the scribe agent mapping meeting topics to the Jira backlog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics", "new_issues", "stats"],
  "properties": {
    "topics": {
      "type": "array",
      "items": { "$ref": "#/$defs/topic" }
    },
    "new_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/new_issue" }
    },
    "stats": { "$ref": "#/$defs/stats" }
  },
  "$defs": {
    "public_safe_category": {
      "type": ["string", "null"],
      "enum": [null, "names", "interpersonal", "hr", "strategy", "security", "legal", "confidential"]
    },
    "public_safe_category_required_when_unsafe": {
      "if": {
        "properties": { "public_safe": { "const": false } },
        "required": ["public_safe"]
      },
      "then": {
        "required": ["public_safe_category"],
        "properties": {
          "public_safe_category": {
            "type": "string",
            "enum": ["names", "interpersonal", "hr", "strategy", "security", "legal", "confidential"]
          }
        }
      }
    },
    "jira_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"
    },
    "topic": {
      "type": "object",
      "required": ["topic", "summary", "confidence", "public_safe"],
      "properties": {
        "topic": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 },
        "existing_issue_id": {
          "anyOf": [{ "$ref": "#/$defs/jira_key" }, { "type": "null" }]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "public_safe": { "type": "boolean" },
        "public_safe_category": { "$ref": "#/$defs/public_safe_category" },
        "omit_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/public_safe_category_required_when_unsafe" }]
    },
    "new_issue": {
      "type": "object",
      "required": [
        "project_id",
        "summary",
        "description",
        "issuetype",
        "priority",
        "confidence",
        "public_safe"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 15000 },
        "issuetype": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["meeting-notes"]
        },
        "components": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "assignee": { "type": ["string", "null"] },
        "parent_issue_id": {
          "anyOf": [{ "$ref": "#/$defs/jira_key" }, { "type": "null" }],
          "description": "Optional parent issue key (e.g. epic). Maps to the Jira native `parent` field (not legacy Epic Link)."
        },
        "story_points_suggestion": {
          "type": ["number", "string", "null"],
          "description": "Advisory story point estimate shown in the issue description only; never written to the Jira story points field."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "public_safe": { "type": "boolean" },
        "public_safe_category": { "$ref": "#/$defs/public_safe_category" }
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/public_safe_category_required_when_unsafe" }]
    },
    "stats": {
      "type": "object",
      "required": [
        "notes_processed",
        "topics_extracted",
        "existing_matched",
        "new_proposed",
        "omitted"
      ],
      "properties": {
        "notes_processed": { "type": "integer", "minimum": 0 },
        "topics_extracted": { "type": "integer", "minimum": 0 },
        "existing_matched": { "type": "integer", "minimum": 0 },
        "new_proposed": { "type": "integer", "minimum": 0 },
        "omitted": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
